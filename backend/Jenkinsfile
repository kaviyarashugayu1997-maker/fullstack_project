pipeline {
    agent any

    environment {
        EC2_IP = "44.216.122.26"
    }

    stages {
        stage('checkout code') {
            steps {
                git branch: 'main',
                    credentialsId: 'mern-stacks09233git',
                    url: 'https://github.com/kaviyarashugayu1997-maker/fullstack_project.git'
            }
        }

        stage('Deploy to EC2') {
            steps {
                sshagent(['mernstack-backend']) {
                    sh """
                    # Note: Using EOF without quotes so Jenkins replaces ${EC2_IP} correctly
                    ssh -o StrictHostKeyChecking=no ubuntu@${EC2_IP} << EOF
                        set -e
                        mkdir -p /home/ubuntu/apps
                        cd /home/ubuntu/apps

                        if [ -d "fullstack_project" ] && [ ! -d "fullstack_project/.git" ]; then
                           rm -rf fullstack_project
                        fi

                        if [ ! -d "fullstack_project" ]; then
                           git clone https://github.com/kaviyarashugayu1997-maker/fullstack_project.git
                        fi

                        cd fullstack_project
                        git fetch origin
                        git checkout main
                        git pull origin main

                        cd backend

                        # Clean up old container and image
                        docker stop myapp || true
                        docker rm myapp || true
                        docker rmi backend-image || true

                        # Build the new image
                        docker build -t backend-image .

                        # Run the container without the MONGO_URI env flag
                        docker run -d -p 5001:5000 --name myapp backend-image
EOF
                    """
                }
            }
        }
    }

    post {
        success {
            echo "DEPLOYMENT SUCCESSFUL"
        }
        failure {
            echo "DEPLOYMENT FAILED"
        }
    }
}
